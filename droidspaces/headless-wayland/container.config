# Droidspaces Container Configuration
# Generated automatically - Changes may be overwritten

name=wayland
hostname=wayland
rootfs_path=/data/local/Droidspaces/Containers/wayland/rootfs.img
disable_ipv6=0
enable_x11=0
enable_android_storage=1
enable_virgl=0
enable_pulseaudio=0
enable_anland=0
enable_hw_access=0
enable_gpu_mode=0
selinux_permissive=0
allow_sandboxing=0
allow_vts=0
allow_swap=1
volatile_mode=0
force_cgroupv1=1
memory_limit=2952790016
cpu_quota=400000
cpu_period=100000
pids_limit=2048
foreground=0
net_mode=nat
static_nat_ip=172.28.10.20
port_forwards=5900:5900/tcp,6080:6080/tcp
uuid=
run_at_boot=1
use_sparse_image=1
