[Unit]
Description=Headless Wayland base (sway headless + wayvnc)
After=network-online.target
Wants=network-online.target

[Service]
User=wl
Environment=XDG_RUNTIME_DIR=/run/headless-wayland
RuntimeDirectory=headless-wayland
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/pkill -u wl -x wayvnc
ExecStart=/usr/local/bin/headless-wayland-session
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
