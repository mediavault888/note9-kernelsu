+/*
+ * Caller's original creds while track_throne() runs (under
+ * throne_tracker_mutex). On pre-5.4 kernels fscrypt keys live in the
+ * process keyring, so ksu_cred (no keyring) gets -ENOKEY on /data/app
+ * APKs; apk_sign.c retries the open with these creds.
+ */
+const struct cred *ksu_throne_orig_cred;
+
 void track_throne(bool prune_only)
 {
 	mutex_lock(&throne_tracker_mutex);
 	const struct cred *old_cred = override_creds(ksu_cred);
+	ksu_throne_orig_cred = old_cred;
 	struct file *fp = filp_open(SYSTEM_PACKAGES_LIST_PATH, O_RDONLY, 0);
 	if (IS_ERR(fp)) {
 		pr_err("%s: open " SYSTEM_PACKAGES_LIST_PATH " failed: %ld\n", __func__,
@@ -296,13 +306,13 @@ void track_throne(bool prune_only)
 	loff_t line_start = 0;
 	char buf[KSU_MAX_PACKAGE_NAME];
 	for (;;) {
-		ssize_t count = kernel_read(fp, &chr, sizeof(chr), &pos);
+		ssize_t count = ksu_kernel_read_compat(fp, &chr, sizeof(chr), &pos);
 		if (count != sizeof(chr))
 			break;
 		if (chr != '\n')
 			continue;
 
-		count = kernel_read(fp, buf, sizeof(buf) - 1, &line_start);
+		count = ksu_kernel_read_compat(fp, buf, sizeof(buf) - 1, &line_start);
 		if (count <= 0) {
 			break;
 		}
@@ -421,6 +431,7 @@ out:
 		kfree(np);
 	}
 out_revert_cred:
+	ksu_throne_orig_cred = NULL;
 	revert_creds(old_cred);
 	mutex_unlock(&throne_tracker_mutex);
 }
